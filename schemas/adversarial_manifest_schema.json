      "type": "string"
    },
    "attack_type": {
      "type": "string"
    },
    "load_id": {
      "type": "string"
    },
    "source_document_type": {
      "type": "string"
    },
    "adversarial_document_path": {
      "type": "string"
    },
    "target_fields": {
